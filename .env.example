# ==============================================================================
# Dock T(w)oo Environment Configuration Template
# Copy this file to .env and provide your desired API keys.
# ==============================================================================

# LLM Providers (Configure at least one provider if using cloud voice reasoning)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: Custom Data Storage Directory (defaults to ~/.dock_twoo/brain)
# DOCK_TWOO_BRAIN_DATA_DIR=/path/to/custom/storage

# Optional: HuggingFace Cache Directory for offline TTS/ASR models
# HUGGINGFACE_HUB_CACHE=/path/to/custom/cache
