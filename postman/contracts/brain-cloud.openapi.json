{
  "openapi": "3.0.3",
  "info": {
    "title": "Brain text-only cloud tool loop",
    "version": "2.1.0",
    "description": "OpenAI-compatible and Anthropic formats. Bounded output. Input/output usage includes context and tools; raw media are excluded."
  },
  "paths": {
    "/chat/completions": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "messages",
                  "tools"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 128,
                    "maximum": 2048
                  },
                  "system": {
                    "type": "string"
                  },
                  "max_completion_tokens": {
                    "type": "integer",
                    "minimum": 128,
                    "maximum": 2048
                  }
                },
                "anyOf": [
                  {
                    "required": [
                      "max_tokens"
                    ]
                  },
                  {
                    "required": [
                      "max_completion_tokens"
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assistant text/tool calls and optional provider-reported token usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "usage": {
                      "type": "object",
                      "description": "Absent means unknown, never estimated as actual usage."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credential"
          },
          "429": {
            "description": "Rate or credit limit"
          },
          "503": {
            "description": "Provider unavailable"
          }
        }
      }
    },
    "/messages": {
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "model",
                  "system",
                  "messages",
                  "tools",
                  "max_tokens"
                ],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "messages": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "max_tokens": {
                    "type": "integer",
                    "minimum": 128,
                    "maximum": 2048
                  },
                  "system": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Assistant text/tool calls and optional provider-reported token usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "usage": {
                      "type": "object",
                      "description": "Absent means unknown, never estimated as actual usage."
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid credential"
          },
          "429": {
            "description": "Rate or credit limit"
          },
          "503": {
            "description": "Provider unavailable"
          }
        }
      }
    }
  }
}
